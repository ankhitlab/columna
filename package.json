{
  "name": "columna-monorepo",
  "private": true,
  "version": "0.4.0",
  "description": "Fluent DataFrame library for TypeScript with WASM and WebGPU backends",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhitlab/columna.git"
  },
  "bugs": {
    "url": "https://github.com/ankhitlab/columna/issues"
  },
  "homepage": "https://github.com/ankhitlab/columna#readme",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:stress": "vitest run packages/core/tests/stress-data.test.ts packages/core/tests/stress-csv.test.ts packages/runtime/tests/stress-spill.test.ts",
    "test:watch": "vitest",
    "lint": "eslint packages",
    "typecheck": "pnpm -r run typecheck",
    "test:consumer": "node scripts/consumer-test.mjs",
    "test:browser": "pnpm --filter @columna/browser-smoke run test:ci",
    "bench": "pnpm --filter @columna/bench run bench",
    "bench:compare": "pnpm --filter @columna/bench run compare",
    "bench:webgpu": "pnpm --filter @columna/bench run webgpu",
    "bench:stats": "pnpm --filter @columna/bench run stats && pnpm --filter @columna/bench run stats:pandas && pnpm --filter @columna/bench run stats:verify",
    "clean": "pnpm -r run clean",
    "bench:compare:js": "pnpm --filter @columna/bench run compare:js",
    "bench:e2e": "pnpm --filter @columna/bench run e2e",
    "bench:advanced": "pnpm --filter @columna/bench run advanced && pnpm --filter @columna/bench run advanced:python && pnpm --filter @columna/bench run advanced:report",
    "test:coverage": "vitest run --coverage",
    "docs:api": "typedoc",
    "release:prepare": "node scripts/release-prepare.mjs",
    "test:interop": "vitest run --config vitest.interop.config.ts",
    "api:snapshot": "node scripts/api-surface.mjs",
    "api:check": "node scripts/api-surface.mjs --check",
    "docs:site": "node scripts/build-site.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^9.16.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "neverBuiltDependencies": [
      "duckdb",
      "nodejs-polars",
      "better-sqlite3"
    ]
  }
}
