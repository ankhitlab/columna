{
  "name": "@columna/bench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "bench": "tsx src/bench.ts",
    "compare": "tsx src/run-compare.ts",
    "compare:columna": "tsx src/compare-columna.ts",
    "compare:python": "py -3 python/compare.py",
    "webgpu": "vite --config vite.config.ts",
    "stats": "node --expose-gc --max-old-space-size=8192 --import tsx src/stats-bench.ts",
    "stats:verify": "node --import tsx src/stats-verify.ts",
    "stats:pandas": "py -3 python/stats_compare.py",
    "advanced": "node --max-old-space-size=8192 --import tsx src/advanced-bench.ts",
    "e2e": "node --max-old-space-size=8192 --import tsx src/e2e-bench.ts",
    "compare:js": "node --max-old-space-size=8192 --import tsx src/compare-js.ts",
    "advanced:python": "py -3 python/advanced_compare.py",
    "advanced:report": "node --import tsx src/advanced-report.ts",
    "advanced:convergence": "node --import tsx src/advanced-convergence.ts && py -3 python/advanced_convergence.py"
  },
  "dependencies": {
    "columna": "workspace:*"
  },
  "devDependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "apache-arrow": "^21.2.0",
    "arquero": "^8.0.3",
    "duckdb": "^1.4.4",
    "nodejs-polars": "^0.26.1",
    "tsx": "^4.19.2",
    "vite": "^6.0.3",
    "web-worker": "^1.5.0"
  }
}
